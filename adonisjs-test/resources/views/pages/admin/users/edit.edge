<!DOCTYPE html>
<html>
<head>
  <title>Upravit uživatele</title>
  <style>
    body { font-family: sans-serif; margin: 40px; background: #f4f4f9; }
    form { background: white; padding: 20px; max-width: 400px; border-radius: 6px; }
    div { margin-bottom: 15px; }
    label { display: block; margin-bottom: 5px; }
    input { width: 100%; padding: 8px; box-sizing: border-box; }
    .btn { padding: 10px 15px; background: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer; }
  </style>
</head>
<body>
  <h1>Upravit uživatele</h1>
  <form action="{{ route('admin.users.update', { id: user.id }) }}?_method=PUT" method="POST">
    {{ csrfField() }}
    <div>
      <label>Jméno a příjmení:</label>
      <input type="text" name="fullName" value="{{ user.fullName || '' }}" required />
    </div>
    <div>
      <label>E-mail:</label>
      <input type="email" name="email" value="{{ user.email }}" required />
    </div>
    <div>
      <label>Nové heslo (ponechte prázdné, pokud nechcete měnit):</label>
      <input type="password" name="password" />
    </div>
    <button type="submit" class="btn">Uložit změny</button>
  </form>
</body>
</html>
